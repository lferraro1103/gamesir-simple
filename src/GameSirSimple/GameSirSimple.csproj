<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeFrameworkVersion>8.0.34</RuntimeFrameworkVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <Content Include="SDL2.dll" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="gamecontrollerdb.txt" />
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
